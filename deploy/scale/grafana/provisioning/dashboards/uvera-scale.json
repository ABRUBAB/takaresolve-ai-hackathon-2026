{
 "uid": "uvera-scale",
 "title": "UVERA scale stack",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Scoring throughput (req/s, all replicas)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (endpoint) (rate(uvera_requests_total[1m]))",
     "legendFormat": "{{endpoint}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Transfer scoring latency (server side)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(uvera_request_seconds_bucket{endpoint=\"transfer\"}[1m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(uvera_request_seconds_bucket{endpoint=\"transfer\"}[1m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(uvera_request_seconds_bucket{endpoint=\"transfer\"}[1m])))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Requests per replica",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (instance) (rate(uvera_requests_total{endpoint=\"transfer\"}[1m]))",
     "legendFormat": "{{instance}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Decisions by risk level",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (risk_level) (rate(uvera_decisions_total[1m]))",
     "legendFormat": "{{risk_level}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Stream: events applied/s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(uvera_worker_events_total[1m]))",
     "legendFormat": "events/s"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Stream: produce -> applied lag p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(uvera_worker_lag_seconds_bucket[1m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Feature drift (PSI vs training reference)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 24,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "uvera_feature_psi",
     "legendFormat": "{{feature}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Replica memory (RSS)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 33,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "uvera_process_rss_bytes",
     "legendFormat": "{{instance}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Errors",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 33,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(uvera_requests_total{outcome=\"error\"}[1m]))",
     "legendFormat": "errors/s"
    },
    {
     "refId": "B",
     "expr": "sum(rate(uvera_shadow_scored_total{outcome=\"error\"}[1m]))",
     "legendFormat": "shadow errors/s"
    }
   ]
  },
  {
   "id": 10,
   "type": "table",
   "title": "Served model versions",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 41,
    "w": 24,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "expr": "uvera_model_info",
     "format": "table",
     "instant": true
    }
   ]
  }
 ]
}