# Copy to .env and fill in. NEVER commit .env or real keys.

# ---------- backend (FastAPI, read by backend/app/core/config.py) ----------
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:3000
MODEL_DIR=../artifacts
WORLD_DIR=../_outputs/world_full
WORLD_SCALE=full
DB_PATH=../_outputs/uvera.db
DEMO_MODE=true
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info

# AI-7 briefs: "cached" (default: briefs pre-generated in NB07, then template) or "live" (calls Gemini, then validator, then template)
LLM_MODE=cached
# Only needed when LLM_MODE=live. Only synthetic data is ever sent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---------- frontend (Next.js) ----------
NEXT_PUBLIC_API_BASE=http://localhost:8000
