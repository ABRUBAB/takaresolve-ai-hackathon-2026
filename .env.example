# Copy to .env (in this folder, the repository root) and adjust. NEVER commit .env or real keys.

# ---------- backend (FastAPI, read by backend/app/core/config.py) ----------
# Signs the demo-role tokens. Empty = a new random secret on every start (fine for the demo).
JWT_SECRET=
# Every website address that may call the API, comma separated (add your Vercel address when the API is public)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Relative paths are relative to backend/
MODEL_DIR=../artifacts
WORLD_DIR=../_outputs/world_full
WORLD_SCALE=full
DB_PATH=../_outputs/uvera.db
DEMO_MODE=true
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info

# AI-7 briefs: "cached" (default: briefs stored by NB07, then template) or "live" (calls Gemini, then validator, then template)
LLM_MODE=cached
# Only needed when LLM_MODE=live. Only synthetic data is ever sent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---------- frontend (Next.js) ----------
# Put this line in frontend/.env.local (Next.js reads its own folder). Unset in a production build = recorded mode.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
